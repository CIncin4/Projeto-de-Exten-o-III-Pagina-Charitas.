# Copie este arquivo para ".env" (na raiz do projeto) e preencha com os valores reais.
# NUNCA suba o arquivo ".env" para o GitHub.

# Connection string do banco (Supabase: Connect > URI; use o Session pooler se sua rede nao tem IPv6)
DATABASE_URL=postgresql://usuario:senha@host:5432/postgres

# Endereco publico do sistema, usado no link do QR code (ex.: https://sap-charitas.onrender.com).
# Rodando no seu computador: http://localhost:5000  (para escanear com o celular use o IP do PC na rede, ex.: http://192.168.0.10:5000)
APP_BASE_URL=http://localhost:5000

# Token do QR fixo da entrada do museu (link: APP_BASE_URL/presenca/<token>).
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(16))"
TOKEN_PRESENCA_GERAL=troque-por-um-token-aleatorio

# Chave que assina o cookie de login do painel. Sem ela o login cai a cada reinicio do servidor.
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria-longa

# So quando o site estiver publicado com HTTPS: cookie de login so trafega por HTTPS.
# COOKIE_SECURE=1
# So quando estiver atras de um proxy de hospedagem (Render, Railway...): usa o IP real do visitante.
# TRUST_PROXY=1
