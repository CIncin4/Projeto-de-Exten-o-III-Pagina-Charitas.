# Copie este arquivo para ".env" e preencha com os valores reais.
# NUNCA suba o arquivo ".env" para o GitHub.

# Connection string do banco (Supabase: Connect > URI; use o Session pooler se sua rede nao tem IPv6)
DATABASE_URL=postgresql://usuario:senha@host:5432/postgres

# Endereco publico do sistema, usado no link do QR code (ex.: https://sap-charitas.onrender.com)
APP_BASE_URL=http://localhost:8000
